---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
	<div class="wrap">
		<header class="page-head">
			<p class="eyebrow">404</p>
			<h1>This page is not here</h1>
			<p class="lead">The file or page may have moved. All brand files are on the downloads page.</p>
			<div class="actions"><a class="button button-primary" href="/downloads/">Go to downloads</a></div>
		</header>
	</div>
</Layout>
